gativeButton("Cancel",null).setNeutralButton("How to find token",(d,w) -> {
             try{startActivity(new Intent(Intent.ACTION_VIEW,Uri.parse("https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/")));}catch(Exception ignored){}
         }).setPositiveButton("Save",(d,w) -> {
             store.saveBasics(server.getText().toString(),mac.getText().toString(),broadcast.getText().toString()); store.saveToken(token.getText().toString());
             store.saveSmb(smbHost.getText().toString(),smbShare.getText().toString(),smbFolder.getText().toString(),smbUser.getText().toString(),smbPass.getText().toString(),smbDomain.getText().toString(),smbEnabled.isChecked(),autoScan.isChecked());
+            int selectedPosition=plexFolderSpinner.getSelectedItemPosition();
+            if(selectedPosition>0 && selectedPosition<folderChoices.size()){ PlexFolderChoice choice=folderChoices.get(selectedPosition); store.savePlexTargetLibrary(choice.libraryKey,choice.libraryTitle,choice.path); }
+            else store.savePlexTargetLibrary("","","");
             rebuildClient(); toast("Settings saved"); show(screen);
         }).show();
     }
 
+    private void applyPlexFolderToNetworkFields(PlexFolderChoice choice, EditText host, EditText share, EditText folder, TextView status) {
+        String path=choice.path==null?"":choice.path.trim();
+        if(path.isEmpty()) { status.setText("Selected "+choice.libraryTitle+". Plex did not return a physical folder path, so keep the network fields below."); return; }
+        String normalized=path.replace('/', '\\');
+        if(normalized.startsWith("\\\\")) {
+            String[] parts=normalized.substring(2).split("\\\\");
+            if(parts.length>=2) {
+                host.setText(parts[0]); share.setText(parts[1]); StringBuilder sub=new StringBuilder();
+                for(int i=2;i<parts.length;i++){ if(parts[i].isEmpty())continue; if(sub.length()>0)sub.append("\\"); sub.append(parts[i]); }
+                folder.setText(sub.toString()); status.setText("✓ Network path filled from Plex: "+path); status.setTextColor(GREEN); return;
+            }
+        }
+        status.setText("Plex folder: "+path+"\nThis is a local server path. Share that folder in Windows, then confirm its SMB share name below."); status.setTextColor(GOLD);
+    }
+
     private EditText input(String hint,String value){EditText e=new EditText(this); e.setHint(hint); e.setHintTextColor(Color.rgb(110,116,126)); e.setTextColor(TEXT); e.setText(value); e.setSingleLine(true); e.setTextSize(15); e.setPadding(dp(12),0,dp(12),0); e.setBackground(round(CARD_2,10)); LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,dp(50)); lp.setMargins(0,0,0,dp(5)); e.setLayoutParams(lp); return e;}
     private CheckBox check(String text,boolean checked){CheckBox c=new CheckBox(this);c.setText(text);c.setTextColor(TEXT);c.setChecked(checked);c.setTextSize(13);c.setButtonTintList(android.content.res.ColorStateList.valueOf(GOLD));c.setPadding(0,dp(5),0,dp(5));return c;}
     private TextView label(String s){TextView t=text(s,11,MUTED,true); t.setPadding(0,dp(12),0,dp(5)); return t;}
